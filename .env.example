# Copy to .env and fill in. Never commit real values.
# Anthropic Messages API key (live scoring only; replay mode needs none)
ANTHROPIC_API_KEY=

# HubSpot private app token (live write-back only; --dry-run needs none)
HUBSPOT_TOKEN=

# Optional: path to a private job-ad snapshot JSONL for replay/eval
# Default looks for ../_segr_private/snapshot/postings.jsonl next to the repo
SEGR_SNAPSHOT=
